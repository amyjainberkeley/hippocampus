#!/usr/bin/env bash
# In-repo wrapper for the graphify CLI.
#
# graphify is installed at ~/.local/bin/graphify (`uv tool install graphifyy`).
# Default Claude Code shells DO NOT include ~/.local/bin on PATH, so a fresh
# session invoking `graphify ...` directly gets command-not-found and silently
# falls back to grep — defeating the point of the graph. Invoke this wrapper
# via `scripts/graphify ...` from any cwd in the repo to avoid the PATH gap.
# See CLAUDE.md ## graphify "Running the CLI" for the full note.

set -e

GRAPHIFY_BIN="${HOME}/.local/bin/graphify"

if [ -x "${GRAPHIFY_BIN}" ]; then
  exec "${GRAPHIFY_BIN}" "$@"
fi

# Fallback: PATH may have graphify via the user's shell rc.
if command -v graphify >/dev/null 2>&1; then
  RESOLVED="$(command -v graphify)"
  SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
  if [ "${RESOLVED}" != "${SELF}" ]; then
    exec graphify "$@"
  fi
fi

echo "scripts/graphify: \"${GRAPHIFY_BIN}\" not found or not executable, and graphify not on PATH." >&2
echo "  Install via:   uv tool install graphifyy" >&2
echo "  Or see:        docs/graphify-setup.md" >&2
exit 127
