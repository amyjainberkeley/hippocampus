# Auto detect text files and perform LF normalization
* text=auto

# SQL migrations are hashed (SHA-256) at runtime by start.sh. Pin line
# endings to LF so a checkout on Windows doesn't produce a different hash
# than what was recorded in prod's schema_migrations on first apply.
# The start.sh runner additionally normalizes CRLF->LF before hashing as
# defense-in-depth, but setting it here prevents the divergence at the
# source (checkouts, diffs, editor saves).
*.sql text eol=lf

# Graphify knowledge-graph artifacts are generated. Mark them so GitHub's
# language stats / diff views collapse them by default, and so merge
# conflicts on the graph file auto-resolve by union (the post-commit hook
# refreshes AST nodes deterministically — conflicts are usually just
# concurrent edits picking up different subsets of changed code).
graphify-out/graph.json linguist-generated=true merge=union
graphify-out/graph.html linguist-generated=true
graphify-out/mci-callflow.html linguist-generated=true
graphify-out/GRAPH_TREE.html linguist-generated=true
graphify-out/GRAPH_REPORT.md linguist-generated=true
graphify-out/manifest.json linguist-generated=true
graphify-out/.graphify_analysis.json linguist-generated=true
graphify-out/.graphify_labels.json linguist-generated=true
graphify-out/cache/** linguist-generated=true
graphify-out/2026-**/** linguist-generated=true
