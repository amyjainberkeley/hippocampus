# Rust
/target/
**/target/
# Cargo.lock is committed per ADR-0005 (MCI ships binaries, not a library).

# Swift / Xcode (macOS adapter, agent, recall UI)
.build/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
xcuserdata/

# Node (browser extensions)
node_modules/
dist/

# Secrets & local state — NEVER commit
.env
.env.*
*.p8
*.pem
*.key
*.keychain
secrets/
mci.sqlite
mci.sqlite-*
*.mci-store

# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Claude Code session artifacts — never commit
.claude/scheduled_tasks.lock
.claude/sessions/
.claude/.skill-cache/
.claude/worktrees/

# ML model artifacts (produced by conversion scripts, not committed)
models/*.mlpackage
models/*.mlmodelc
models/*.tar.gz
*.mlpackage
*.mlmodelc

# Python ML conversion venv (scripts/convert_brief_model.py)
.venv-ml/

# Tokenizer artifacts written alongside the Core ML model by
# convert_brief_model.py — ship via the same HF tarball, not the repo.
models/tokenizer*.json
models/vocab.json
models/merges.txt
models/special_tokens_map.json
models/added_tokens.json
models/chat_template.jinja

# Per-model sidecars written by convert_ner.py (V2-P5+ P1') — these live in
# SUBDIRS / use a <model>_ prefix that the rules above don't reach, so the
# small JSON/vocab files would otherwise be committable. Ship via HF (P6).
models/*_tokenizer/
models/*_labels.json
# Conversion logs (e.g. convert_ner.py stdout/stderr captured to models/) —
# transient build output, never committed.
models/*.log

# Output redirects from CLI flag-as-filename mistakes (e.g. --skip-sudo)
/--*

# perf-soak run artifacts (JSONL samples, agent stdout, device-id, health log).
# Score cards from analyze.py are the shareable artifact; raw runs stay local.
tools/perf-soak/out/

# scripts/try-it.sh sandbox
hippocampus-demo/
